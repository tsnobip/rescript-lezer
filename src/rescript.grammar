@precedence {
  member,
  variant,
  polyvariant,
  call,
  parenConstraint,
  prefix,
  times @left,
  plus @left,
  shift @left,
  bitand @left,
  bitxor @left,
  bitor @left,
  concat @left,
  pipe @left,
  rel @left,
  and @left,
  or @left,
  typearg @left,
  assign @right,
  ternary @right,
  annotation @left,
  arrow @right,
  decoratorStatement,
  decorator,
  statement @cut
}

@top Script { scriptItem* }

scriptItem {
  statement |
  ";"
}

@top SingleExpression { expression }

statement[@isGroup=Statement] {
  Decorator !decoratorStatement |
  LetBinding |
  ModuleDeclaration |
  ModuleTypeDeclaration |
  TypeDeclaration |
  TypeExtension |
  OpenStatement |
  IncludeStatement |
  ExternalDeclaration |
  ExceptionDeclaration |
  expression ~jsxAttribute
}

ModuleDeclaration {
  kw<"module"> (ModuleName ModuleDeclarationBody | RecursiveModuleBindings)
}

RecursiveModuleBindings {
  kw<"rec"> ModuleName ModuleDeclarationBody (~binding Decorator* kw<"and"> ModuleName ModuleDeclarationBody)* ~binding
}

ModuleTypeDeclaration {
  kw<"module"> kw<"type"> (ModuleName | TypeName) ("=" ModuleTypeExpr ModuleWithConstraint*)?
}

ModuleDeclarationBody {
  ModuleSpec "=" ModuleExpression ~moduleCall |
  ModuleSpec |
  "=" ModuleExpression ~moduleCall
}

ModuleSpec {
  ":" ModuleTypeExpr ModuleWithConstraint*
}

ModuleWithConstraint {
  softkw<"with"> moduleTypeConstraint (~moduleAnd kw<"and"> moduleTypeConstraint)* ~moduleAnd
}

moduleTypeConstraint {
  kw<"type"> ModulePrefix? TypeName TypeParams? ConstraintOperator kw<"private">? type TypeConstraint* |
  kw<"module"> ModulePath ConstraintOperator ModulePath
}

ConstraintOperator {
  "=" |
  ":="
}

ModuleTypeExpr {
  ModuleTypeBody |
  ModulePath |
  ModuleFunctorType |
  TypeName |
  TypePath |
  ParenthesizedModuleType |
  DecoratedModuleType |
  ModuleTypeOf |
  ExtensionExpression
}

ParenthesizedModuleType { "(" ModuleTypeExpr ~modulePattern ModuleWithConstraint* ")" }
DecoratedModuleType { Decorator ModuleTypeExpr }
ModuleTypeOf { kw<"module"> kw<"type"> kw<"of"> ModuleExpression ~moduleCall }

ModuleFunctorType {
  "(" commaSep<ModuleTypeParameter> ")" "=>" ModuleTypeExpr |
  UnitToken "=>" ModuleTypeExpr |
  ModuleTypeExpr !arrow "=>" ModuleTypeExpr
}

ModuleTypeParameter {
  (ModuleName | TypeName) ~modulePattern ":" ModuleTypeExpr |
  ModuleTypeExpr ~modulePattern |
  UnitToken |
  Decorator ModuleTypeParameter
}

ModuleExpression { moduleExpression ~moduleCall }

moduleExpression {
  ModuleBody |
  ModulePath |
  ModulePackExpression |
  ModuleUnpackExpression |
  ModuleFunctor |
  ModuleApplication |
  ParenthesizedModuleExpression |
  DecoratedModuleExpression |
  ModuleAwaitExpression |
  ExtensionExpression
}

ParenthesizedModuleExpression { "(" ModuleExpression ModuleSpec? ")" }
DecoratedModuleExpression { Decorator ModuleExpression ~moduleCall }
ModuleAwaitExpression { kw<"await"> ModuleExpression ~moduleCall }

ModuleFunctor { ("(" commaSep<ModuleParameter> ")" | UnitToken) ModuleReturnSpec? "=>" ModuleExpression }
ModuleReturnSpec { ":" ModuleTypeExpr !parenConstraint }
ModuleParameter { ModuleName ~modulePattern ModuleSpec? | UnitToken | Decorator ModuleParameter }
ModuleApplication[@dynamicPrecedence=1] { ModuleExpression ~moduleCall ("(" commaSep<ModuleArgument> ")" | UnitToken) }
ModuleArgument { ModuleExpression ModuleSpec? | UnitToken }

ModuleUnpackSpec { ModuleUnpackColon ModuleTypeExpr ModuleWithConstraint* }
ModuleUnpackExpression { softkw<"unpack"> "(" expression ModuleUnpackSpec? ")" }

ModuleName { uppercaseIdentifier }

ModulePackExpression {
  kw<"module"> "(" ModulePackContent ")"
}

ModulePackContent {
  moduleExpression ~modulePattern ModuleSpec? ~modulePattern
}

ModuleBody {
  "{" blockItem* "}"
}

ModuleTypeBody {
  "{" (ModuleTypeStatement | ";")* "}"
}

ModuleTypeStatement {
  ModuleTypeDeclaration |
  ModuleTypeModuleSpec |
  TypeSpec |
  ValueSpec |
  ExceptionDeclaration |
  Decorator ~decorated |
  ExtensionExpression ~payload |
  ExternalDeclaration |
  OpenStatement |
  ModuleTypeInclude |
  ModuleTypeAlias
  | RecursiveModuleSpec
  | TypeExtension
}

RecursiveModuleSpec { kw<"module"> kw<"rec"> ModuleName ModuleSpec (~binding Decorator* kw<"and"> ModuleName ModuleSpec)* ~binding }

ModuleTypeInclude { kw<"include"> ModuleTypeExpr ModuleWithConstraint* }
ModuleTypeAlias { kw<"module"> ModuleName "=" ModulePath }

ModuleTypeModuleSpec {
  kw<"module"> ModuleName ModuleSpec
}

TypeSpec {
  kw<"type"> kw<"rec">? TypeName TypeParams? ("=" TypeBody)? TypeConstraint* (~binding Decorator* kw<"and"> TypeBinding)* ~binding
}

ValueSpec {
  kw<"let"> VariableDefinition ":" type
}

ModulePath {
  ModulePrefix? ModuleName ~modulePattern
}

OpenStatement {
  kw<"open"> LogicOp<"!">? ModulePath
}

IncludeStatement {
  kw<"include"> moduleExpression ~moduleCall
}

ExternalDeclaration {
  kw<"external"> VariableDefinition ":" type "=" ExternalBody
}

ExternalBody {
  String |
  TemplateString
}

ExceptionDeclaration {
  kw<"exception"> ExceptionName (
    VariantConstructorArgs VariantConstructorResult? |
    VariantConstructorResult |
    "=" ModulePrefix? VariantConstructor
  )?
}

ExceptionName { uppercaseIdentifier }

LetBinding {
  kw<"let"> (
    kw<"module"> ModuleUnpackBinding |
    LetRecBindings |
    LetValueBinding (~binding Decorator* kw<"and"> LetValueBinding)* ~binding
  )
}

LetValueBinding {
  DestructuringPattern (":" type)? "=" expression |
  VariableDefinition ParamList? (":" type)? "=" expression |
  PatternBinding
}

PatternBinding[@dynamicPrecedence=-1] { Pattern "=" expression }

LetRecBindings {
  kw<"rec"> LetRecBinding (~binding Decorator* kw<"and"> LetRecBinding)* ~binding
}

LetRecBinding {
  VariableDefinition ParamList? (":" type)? "=" expression
}

ModuleUnpackBinding[@dynamicPrecedence=1] {
  "(" ModuleName ~modulePattern ")" "=" expression
}

SwitchExpression[@dynamicPrecedence=1] {
  kw<"switch"> expression "{" SwitchCase* "}"
}

SwitchCase[@dynamicPrecedence=-1] {
  "|" Pattern (PatternGuard)? "=>" blockItem+
}

IfExpression {
  kw<"if"> expression BlockExpression ElseClause?
}

ElseClause {
  kw<"else"> (IfExpression | BlockExpression)
}

WhileExpression {
  kw<"while"> expression BlockExpression
}

ForExpression {
  kw<"for"> (forHeader | "(" forHeader ")") BlockExpression
}

forHeader {
  Pattern kw<"in"> expression ForDirection expression |
  kw<"await">? VariableName kw<"of"> expression
}

ForDirection {
  softkw<"to"> |
  softkw<"downto">
}

TryExpression {
  kw<"try"> expression softkw<"catch"> "{" SwitchCase* "}"
}

BlockExpression {
  "{" blockItem* "}"
}

blockItem {
  statement |
  ";"
}

// Pattern guards may start with `if` or `when`. Any expression is allowed
// inside the guard, so we accept a bare `expression` here. `if` is preferred.
PatternGuard {
  kw<"if"> expression |
  kw<"when"> expression
}

Pattern {
  PatternPrimary ~parameter (PatternAnnotation | PatternAlias)* ~parameter ("|" PatternPrimary ~parameter (PatternAnnotation | PatternAlias)* ~parameter)*
}

PatternAnnotation { ":" annotationType ~typeAlias }

PatternAlias {
  ~typeAlias kw<"as"> Decorator* VariableName
}

Decorator {
  decorator<"@" | "@@">
}

decorator<prefix> {
  prefix AttributeIdentifier ~decorated |
  prefix AttributeIdentifier !decorator AttributeArguments ~decorated
}

AttributeArguments {
  AttributeArgsOpen attributePayload ")"
}

attributePayload {
  commaSep<expression> |
  AttributeStructurePayload |
  ":" (type | ModuleTypeStatement+) |
  "?" Pattern PatternGuard?
}
AttributeStructurePayload[@dynamicPrecedence=-1] { blockItem+ }

Wildcard { "_" }

PatternPrimary {
  (
  Wildcard |
  VariantSpreadPattern |
  PolyVariantSpreadPattern |
  TuplePattern |
  VariableName |
  Number |
  SignedPattern |
  RangePattern |
  ExceptionPattern |
  DecoratedPattern |
  ModulePattern |
  ExtensionExpression |
  TemplateString |
  String |
  Char |
  boolean |
  UnitPattern |
  ConstructorPattern |
  ArrayPattern |
  ListPattern |
  DictPattern |
  RecordPattern |
  PolyVariantPattern |
  ParenthesizedPattern
  ) ~parameter
}

VariantSpreadPattern {
  SpreadOperator (TypeName | TypePath | TypeApplication)
}

SignedPattern { (ArithOp<"-"> | ArithOp<"-."> | ArithOp<"+"> | ArithOp<"+.">) Number }
RangePattern { (Char | Number | SignedPattern) ".." (Char | Number | SignedPattern) }
ExceptionPattern { kw<"exception"> PatternPrimary }
DecoratedPattern { Decorator ~decorated PatternPrimary ~parameter }
ModulePattern { kw<"module"> "(" ModulePath ~modulePattern ModuleSpec? ~modulePattern ")" }

UnitPattern { UnitToken ~annotation | "(" ")" }

ConstructorPattern {
  ModulePrefix? VariantConstructor ~pattern PatternArguments? ~pattern
}

ArrayPattern {
  "[" commaSep<Pattern> "]"
}

ListPattern {
  softkw<"list"> "{" commaSep<Pattern> "}"
}

TuplePattern {
  "(" Pattern ~parameter "," commaSep1<Pattern> ")"
}

DestructuringPattern {
  (
  TuplePattern |
  ArrayPattern |
  ListPattern |
  DictPattern |
  RecordPattern |
  ConstructorPattern |
  PolyVariantPattern |
  UnitPattern |
  VariantSpreadPattern |
  PolyVariantSpreadPattern |
  Wildcard
  | ParenthesizedPattern
  | ExceptionPattern
  | ModulePattern
  ) ~parameter
}

RecordPattern {
  "{" commaSep1<PatternField> "}"
}

PatternField {
  SpreadOperator (TypeName | TypePath | TypeApplication) PatternAlias? |
  "?" VariableName |
  VariableName ~parameter |
  ModulePrefix PropertyName |
  ModulePrefix? PropertyName ":" "?"? Pattern
}

DictPattern {
  softkw<"dict"> "{" commaSep<DictPatternField> "}"
}

DictPatternField {
  String ":" DictPatternValue
}

DictPatternValue {
  "?" VariableName |
  Pattern
}

PolyVariantPattern {
  PolyVariantTag PatternArguments? ~pattern
}

PolyVariantSpreadPattern {
  Hash SpreadOperator (TypeName | TypePath | TypeApplication)
}

PatternArguments {
  ~pattern "(" commaSep<Pattern> ")"
}

VariantLiteral {
  VariantConstructor VariantArguments? ~pattern
}

VariantArguments {
  !variant "(" commaSep<expression> ")"
}

PolyVariantLiteral {
  PolyVariantTag PolyVariantArguments? ~pattern
}

PolyVariantArguments {
  !polyvariant "(" commaSep<expression> ")"
}

ParenthesizedPattern {
  "(" Pattern ~parameter ")"
}

expression {
  (
  AwaitExpression |
  AssertExpression |
  IfExpression |
  WhileExpression |
  ForExpression |
  TryExpression |
  SwitchExpression |
  BlockExpression |
  Number |
  String |
  TemplateString |
  TaggedTemplateExpression { VariableName !call TemplateString } |
  Char |
  boolean |
  AsyncExpression |
  ArrowFunction |
  VariableName ~parameter |
  VariantLiteral |
  PolyVariantLiteral |
  RegExpLiteral |
  UnitToken ~annotation |
  ArrayExpression |
  ListExpression |
  DictExpression |
  RecordExpression |
  DecoratedExpression { Decorator !decorator expression } |
  ExtensionExpression |
  ModulePackExpression |
  CallExpression |
  MemberExpression |
  ConstrainedExpression[@dynamicPrecedence=-2] { expression ~annotation !annotation IndexConstraint } |
  TernaryExpression { expression !ternary "?" expression TernaryColon expression } |
  BinaryExpression {
    expression !assign "=" expression |
    expression !assign ":=" expression |
    expression !assign "#=" expression |
    expression !times (ArithOp<"**"> | ArithOp<"*"> | DivisionOp | ArithOp<"*."> | softkw<"mod">) expression |
    expression !plus (ArithOp<"+"> | ArithOp<"-"> | ArithOp<"+."> | ArithOp<"-.">) expression |
    expression !shift ShiftOp expression |
    expression !bitand BitAndOp expression |
    expression !bitxor BitXorOp expression |
    expression !bitor BitOrOp expression |
    expression !concat StringOp<"++"> expression |
    expression !pipe PipeOp<"->" | "|>"> expression |
    expression !rel (LessThan | CompareOp<"<=" | ">" | ">=" | "==" | "!=" | "===" | "!==">) expression |
    expression !and LogicOp<"&&"> expression |
    expression !or LogicOp<"||"> expression
  } |
  UnaryExpression { !prefix (ArithOp<"-"> | ArithOp<"-."> | ArithOp<"+"> | ArithOp<"+."> | LogicOp<"!"> | BitNotOp) expression } |
  ParenthesizedExpression ~annotation |
  TupleExpression |
  JSXElement
  ) ~parameter ~jsxAttribute
}

ArrayExpression { "[" commaSep<collectionItem> "]" }
ListExpression[@dynamicPrecedence=2] { softkw<"list"> "{" commaSep<collectionItem> "}" }
DictExpression[@dynamicPrecedence=2] { softkw<"dict"> "{" commaSep<DictEntry> "}" }
RecordExpression[@dynamicPrecedence=1] { "{" commaSep1<Property> "}" }

AwaitExpression { kw<"await"> expression }
AssertExpression { !prefix kw<"assert"> expression }
ExtensionExpression {
  ("%" | "%%") AttributeIdentifier |
  ("%" | "%%") AttributeIdentifier !decorator AttributeArguments
}
AsyncExpression { softkw<"async"> expression }
ParenthesizedExpression[@dynamicPrecedence=-1] {
  "(" expression ~annotation (IndexConstraint !parenConstraint)? ~parenthesized ")" !arrow
}

ArrowFunction[@dynamicPrecedence=1] {
  ParamList ReturnTypeAnnotation? !arrow "=>" expression |
  UnitToken ~annotation ReturnTypeAnnotation? !arrow "=>" expression |
  SingleParam !arrow "=>" expression
}

ReturnTypeAnnotation {
  ":" annotationType
}

annotationType {
  type ~typeAlias
}
TupleExpression { "(" expression "," commaSep1<expression> ")" }

SingleParam { VariableName ~parameter }

MemberExpression {
  ModulePrefix MemberLeaf |
  RecordFieldAccess |
  expression !member IndexOpen expression ~annotation (IndexConstraint !parenConstraint)? "]"
}

IndexConstraint {
  ":" type ~annotation (":>" type)? ~annotation |
  ":>" type
}

RecordFieldAccess {
  expression !member "." PropertyName |
  expression !member "." ModulePrefix PropertyName
}

CallExpression {
  expression !call "(" DotUncurried? commaSep<Argument> ")" |
  expression !call UnitToken
}

MemberLeaf {
  VariantConstructor ~pattern |
  VariableName
}


DictEntry {
  String ":" expression |
  SpreadExpression
}

collectionItem { expression | SpreadExpression }
SpreadExpression { SpreadOperator expression }

Property {
  OptionalPropertyPun |
  (PropertyDefinition | String) ~parameter ":" "?"? expression |
  PropertyPun |
  SpreadExpression
}

PropertyPun { PropertyDefinition }

OptionalPropertyPun {
  "?" PropertyDefinition
}

Argument {
  LabeledArgument |
  expression |
  SpreadOperator
}

LabeledArgument {
  "~" LabelName "?"? LabeledArgumentAnnotation? ("=" ArgumentValue)?
}

LabeledArgumentAnnotation {
  ":" type
}

ArgumentValue {
  "?" expression? |
  expression
}

ParamList {
  "(" DotUncurried? ParamItems ")" |
  "(" DotUncurried ")"
}

DotUncurried { "." }

ParamItems {
  Decorator ParamItems |
  LabeledParameterList |
  LocalTypeParameter ("," parameter?)* |
  SingleParameter |
  UnlabeledParameter "," parameter ("," parameter?)*
}

LocalTypeParameter { kw<"type"> TypeName+ }

LabeledParameterList {
  LabeledParameter ("," parameter?)*
}

SingleParameter[@dynamicPrecedence=-1] { SimpleParameter }

parameter {
  LabeledParameter |
  SimpleParameter |
  Decorator parameter |
  LocalTypeParameter
}

LabeledParameter {
  "~" LabelName PatternAlias? ParameterAnnotation? ParameterDefault?
}

UnlabeledParameter { SimpleParameter }

SimpleParameter {
  VariableName ~parameter PatternAlias? ParameterAnnotation? ParameterDefault? |
  DestructuringPattern PatternAlias? ParameterAnnotation? ParameterDefault? |
  LiteralParameter PatternAlias? ParameterAnnotation? ParameterDefault? |
  PatternParameter ParameterDefault?
}

LiteralParameter { (Number | String | Char | boolean | ExtensionExpression | TemplateString) ~parameter }
PatternParameter[@dynamicPrecedence=-1] { Pattern ~parameter }

ParameterAnnotation {
  ":" type
}

ParameterDefault {
  "=" ("?" expression? | expression)
}

FunctionTypeParamList {
  "(" DotUncurried? FunctionTypeParamItems ")" ~functionType
}

FunctionTypeParamItems {
  "" ~functionType |
  FunctionTypeLabeledParamList |
  FunctionTypeSingleParam |
  FunctionTypeUnlabeledParam "," FunctionTypeParameter ("," FunctionTypeParameter?)*
}

FunctionTypeLabeledParamList {
  FunctionTypeLabeledParam ("," FunctionTypeParameter?)*
}

FunctionTypeSingleParam { FunctionTypeSimpleParam }

FunctionTypeParameter {
  FunctionTypeLabeledParam |
  FunctionTypeSimpleParam
}

FunctionTypeLabeledParam {
  Decorator FunctionTypeLabeledParam |
  "~" LabelName FunctionTypeAnnotation ParameterDefault?
}

FunctionTypeUnlabeledParam { FunctionTypeSimpleParam }

FunctionTypeSimpleParam[@dynamicPrecedence=1] {
  Decorator FunctionTypeSimpleParam |
  type ~functionType |
  VariableName FunctionTypeAnnotation ParameterDefault?
}

FunctionTypeAnnotation {
  ":" type
}

ParenthesizedType { "(" type ~functionType ")" }
TupleType { "(" tupleTypeItem "," commaSep1<tupleTypeItem> ")" }
tupleTypeItem { type ~functionType }

Quote { "'" }
Hash { "#" }

TypeParameter { Quote (VariableName | uppercaseIdentifier) }

FunctionType {
  (FunctionTypeParamList | TypeName | TypePath | TypeParameter | TypeApplication | DictType | ListType | ParenthesizedType | RecordType | ObjectType | ModulePackageType | PolyVariantType | AliasedType | FunctionTypeLabeledParam) ~typeAlias FunctionArrow type
}

FunctionArrow { "=>" }

type[@isGroup=Type] {
  (
  TypePath |
  TypeName |
  TypeParameter |
  PolyVariantType |
  DictType |
  ListType |
  TypeApplication |
  ParenthesizedType |
  TupleType |
  FunctionType |
  ModulePackageType |
  RecordType |
  ObjectType |
  DecoratedType |
  QuantifiedType |
  AliasedType
  | UnitType
  | LocallyAbstractType
  | ExtensionType
  ) ~typeBody ~typeAlias
}

ObjectType { "{" (".." | ".") commaSep<RecordTypeField> "}" }
UnitType { "(" ~functionType ")" ~functionType }
LocallyAbstractType { kw<"type"> TypeName+ "." type }
ExtensionType { ExtensionExpression ~payload }
DecoratedType { Decorator ~decorated type }
QuantifiedType { (TypeParameter ~typeAlias)+ "." type }
AliasedType { type ~typeAlias kw<"as"> TypeParameter }

ModulePackageType { kw<"module"> "(" ModuleTypeExpr ModuleWithConstraint* ")" }


TypeAngleLeftNode { TypeAngleLeftToken }
TypeAngleRightNode { TypeAngleRightToken }

DictType[@dynamicPrecedence=1] { softkw<"dict"> TypeAngleLeftNode type TypeAngleRightNode }
ListType[@dynamicPrecedence=1] { softkw<"list"> TypeAngleLeftNode type TypeAngleRightNode }

TypeApplication { (TypeName | TypePath) TypeAngleLeftNode commaSep<type> TypeAngleRightNode }

TypeParams { TypeAngleLeftNode commaSep<TypeParam> TypeAngleRightNode }

TypeParam { (ArithOp<"+"> | ArithOp<"-">)? ("_" | VariableDefinition | TypeParameter) }

RecordType {
  "{" commaSep<RecordTypeField> "}"
}

RecordTypeField {
  Decorator* kw<"mutable">? (PropertyDefinition "?"? (":" type)? | String ":" type) |
  SpreadOperator (TypeName | TypePath)
}

PolyVariantName { uppercaseIdentifier | identifier | exoticIdentifier | Number | String }
PolyVariantTag { Hash PolyVariantName }

// Variance marker for polymorphic variants: lower-bound '>' or upper-bound '<'
PolyVariantVarianceLower { CompareOp<"<"> }
PolyVariantVarianceUpper { CompareOp<">"> }
PolyVariantVarianceMarker { PolyVariantVarianceUpper | PolyVariantVarianceLower }

// PolyVariantType: one-or-more variant tags separated by pipe `|` (e.g. [#A | #B])
PolyVariantType {
  "[" PolyVariantVarianceMarker? (PolyVariantCaseList (PolyVariantVarianceUpper PolyVariantTag+)?)? "]" (~typeAlias kw<"as"> TypeParameter)? ~typeAlias
}

PolyVariantCaseList {
  ("|")? PolyVariantCase ("|" PolyVariantCase)*
}

PolyVariantCase {
  Decorator* (
  PolyVariantSpreadCase |
  PolyVariantTagCase |
  PolyVariantTypeReference
  )
}

PolyVariantPayload {
  "(" commaSep1<type> ")"
}

PolyVariantTagCase {
  PolyVariantTag PolyVariantPayload? ("&" PolyVariantPayload)*
}

PolyVariantSpreadCase {
  Hash SpreadOperator TypeName
}

PolyVariantTypeReference {
  TypeName | TypePath | TypeApplication
}

// Type declaration supports optional `rec` and optional type parameters
TypeDeclaration {
  kw<"type"> (kw<"rec">)? TypeBinding (~binding Decorator* kw<"and"> TypeBinding)* ~binding
}

TypeBinding {
  TypeName (TypeParams)? ("=" TypeBody)? TypeConstraint*
}

TypeConstraint { kw<"constraint"> type "=" type }

TypeBody {
  kw<"private">? (
  VariantType |
  ExtensibleVariantType |
  RecordType ~typeBody |
  TypeAlias ("=" kw<"private">? (RecordType | VariantType))?
  )
}

TypeAlias[@dynamicPrecedence=-1] { type }
ExtensibleVariantType { (Decorator ~decorated)* ".." }

TypeExtension {
  kw<"type"> (TypeName | TypePath) TypeParams? "+=" kw<"private">? ExtensionConstructorList
}
ExtensionConstructorList { "|"? ExtensionConstructor (~case "|" ExtensionConstructor)* ~case }
ExtensionConstructor { VariantConstructorCase ("=" ModulePrefix? VariantConstructor)? }

VariantType {
  "|"? VariantConstructorCase (~case "|" VariantConstructorCase)* ~case
}

VariantConstructorCase {
  (Decorator ~decorated)* (
  VariantSpreadCase |
  VariantConstructorArgsToken VariantConstructorArgs VariantConstructorResult? |
  VariantConstructorResultToken VariantConstructorResult |
  VariantConstructor VariantConstructorArgs? VariantConstructorResult?
  )
}

VariantSpreadCase {
  SpreadOperator TypeName
}

VariantConstructorArgs {
  !variant "(" commaSep1<type> ")"
}

VariantConstructorResult {
  ":" type
}

commaSep<content> {
  "" ~pattern | content ("," content?)* ~jsxAttribute
}

commaSep1<content> {
  content ("," content?)*
}

// Keywords
kw<term> { @specialize[@name={term}]<identifier, term> }

softkw<term> { @extend[@name={term}]<identifier, term> }

boolean { @specialize[@name=BooleanLiteral]<identifier, "true" | "false"> }

VariableName { (identifier | exoticIdentifier) ~record }
VariableDefinition { (identifier | exoticIdentifier) ~record }
TypePath {
  ModulePrefix TypeName
}
TypeName { (identifier | exoticIdentifier) ~record }
VariantConstructor { uppercaseIdentifier }
PropertyName { (identifier | exoticIdentifier) ~record }
PropertyDefinition { (identifier | exoticIdentifier | ModulePrefix (identifier | exoticIdentifier)) ~record }
LabelName { identifier | exoticIdentifier }

@skip { spaces | newline | LineComment | BlockComment }

@context trackNewline from "./tokens.js"

@external tokens variant from "./tokens" { VariantConstructorArgsToken, VariantConstructorResultToken }
@external tokens comments from "./tokens" { BlockComment[isolate] }
@external tokens regexp from "./tokens" { RegExpLiteral }
@external tokens ternaryColon from "./tokens" { TernaryColon[@name=":"], ModuleUnpackColon[@name=":"] }
@external tokens attributeArgs from "./tokens" { AttributeArgsOpen[@name="("] }
@external tokens postfix from "./tokens" { IndexOpen[@name="["] }
@external tokens unit from "./tokens" { UnitToken }
@external tokens typeAngle from "./tokens" { TypeAngleLeftToken[@name=CompareOp], TypeAngleRightToken[@name=CompareOp] }
@external tokens jsxTag from "./tokens" { JSXIdentifier, JSXEndTag }
@external tokens jsx from "./tokens" { JSXStartTag, JSXStartCloseTag, LessThan[@name=CompareOp] }

@skip {} {
  String[isolate] {
    '"' (stringContentDouble | Escape)* '"'
  }
  
  TemplateString[isolate] {
    "`" (TemplateContent | TemplateEscape | Interpolation)* "`"
  }
  

}

TemplateContent {
  templateText
}

Interpolation {
  "${" expression "}"
}

@tokens {
  spaces[@export] { $[\u0009 \u000b\u00a0\u1680\u2000-\u200a\u202f\u205f\u3000\ufeff]+ }
  newline[@export] { $[\r\n\u2028\u2029] }

  LineComment[isolate] { "//" ![\n]* }

  identifierChar { @asciiLetter | $[_$] }
  
  identifier { $[a-z_] (identifierChar | @digit | "'" )* }
  
  ModulePrefix { $[A-Z] (identifierChar | @digit | "'" )* ("." $[A-Z] (identifierChar | @digit | "'" )*)* "." }
  exoticIdentifier { "\\\"" !["\n\r]* "\"" }
  SpreadOperator { "..." }
  
  uppercaseIdentifier { $[A-Z] (identifierChar | @digit | "'" )* }

  @precedence { ModulePrefix, SpreadOperator, uppercaseIdentifier }

  @precedence { spaces, newline, identifier, "_" }

  Number {
    (@digit ("_" | @digit)* ("." ("_" | @digit)*)? | "." @digit ("_" | @digit)*)
      (("e" | "E") ("+" | "-")? ("_" | @digit)+)? $[nlL]? |
    "0" $[xX] $[0-9a-fA-F_]+ ("." $[0-9a-fA-F_]*)?
      ($[pP] $[+-]? $[0-9_]+)? $[nlL]? |
    "0" $[bB] $[01_]+ $[nlL]? |
    "0" $[oO] $[0-7_]+ $[nlL]?
  }

  @precedence { Number, "." }

  Char { "'" (![\\\n'] | "\\" ("x" $[0-9a-fA-F] $[0-9a-fA-F] | "o" $[0-7] $[0-7] $[0-7] | @digit @digit @digit | "u" ("{" $[0-9a-fA-F]+ "}" | $[0-9a-fA-F] $[0-9a-fA-F] $[0-9a-fA-F] $[0-9a-fA-F]) | _)) "'" }

  Escape {
    "\\" ("x" $[0-9a-fA-F] $[0-9a-fA-F] | "u" ("{" $[0-9a-fA-F]+ "}" | $[0-9a-fA-F] $[0-9a-fA-F] $[0-9a-fA-F] $[0-9a-fA-F]) | ![xu])
  }


  stringContentDouble { ![\\"]+ }
  
  DivisionOp[@name=ArithOp,@export] { "/" | "/." }
  ArithOp<expr> { expr }
  ShiftOp { "<<<" | ">>>" | "<<" | ">>" }
  BitAndOp { "&&&" }
  BitOrOp { "|||" }
  BitXorOp { "^^^" }
  BitNotOp { "~~~" }
  LogicOp<expr> { expr }
  CompareOp<expr> { expr }
  StringOp<expr> { expr }
  PipeOp<expr> { expr }
  
  templateText { ![\\`$]+ | "$" }
  TemplateEscape { "\\" _ }
  @precedence { "${", templateText }

  @precedence { LineComment, BitNotOp, ShiftOp, BitAndOp, BitXorOp, BitOrOp, ArithOp, DivisionOp }

  "=>"
  "..."
  "("  ")" "[" "]" "{" "}"
  "." ".." "," ":" ";"
  "=" "?" "|" "~" "'" "@" "%" "_" "`" "${" ":=" ":>"
  "@@" "%%"
  "+=" "#="

  "+." "-." "*." "/."

  
  JSXSelfCloseEndTag { "/>" }

  AttributeIdentifier {
    (identifier | uppercaseIdentifier | exoticIdentifier) ("." (identifier | uppercaseIdentifier | exoticIdentifier))*
  }
}

JSXElement {
  JSXSelfClosingTag |
  JSXOpenTag jsxChildren* JSXCloseTag |
  JSXFragment
}

JSXFragment { JSXFragmentOpenTag jsxChildren* JSXFragmentCloseTag }
jsxChildren { jsxChildValue | JSXExpressionContainer }

jsxBlock[@dynamicPrecedence=-1] { BlockExpression ~jsxAttribute }

JSXExpressionContainer[@dynamicPrecedence=2] {
  "{" expression ~jsxAttribute "}" |
  jsxBlock
}

JSXSelfClosingTag { JSXStartTag jsxElementName jsxAttribute* JSXSelfCloseEndTag }
JSXFragmentOpenTag { JSXStartTag JSXEndTag }
JSXFragmentCloseTag { JSXStartCloseTag JSXEndTag }
JSXOpenTag { JSXStartTag jsxElementName jsxAttribute* JSXEndTag }
JSXCloseTag { JSXStartCloseTag jsxElementName? JSXEndTag }

JSXIntrinsicElementName { JSXIdentifier }
JSXCustomComponentName { ModulePath | ModulePrefix JSXIdentifier }

jsxElementName {
  JSXIntrinsicElementName |
  JSXCustomComponentName
}

jsxAttribute {
  JSXAttribute { "?"? (JSXIdentifier | exoticIdentifier) ("=" "?"? jsxAttributeValue)? } |
  JSXSpreadAttribute { "{" SpreadOperator expression "}" }
}

jsxAttributeValue { (jsxAtomicValue | "{" expression ~jsxAttribute "}" | jsxBlock) ~jsxAttribute }

jsxAtomicValue { (jsxAtom | JSXMemberExpression | JSXCallExpression) ~jsxAttribute }
jsxChildValue { (jsxAtom | JSXChildMemberExpression) ~jsxAttribute }
jsxAtom { (
  String | Number | Char | boolean | VariableName |
  ParenthesizedExpression | TupleExpression |
  RegExpLiteral | TemplateString | UnitToken |
  ArrayExpression | ListExpression | DictExpression | RecordExpression |
  VariantLiteral | PolyVariantLiteral | ModulePackExpression | JSXElement | ExtensionExpression
) ~jsxAttribute }
JSXChildMemberExpression[@name=MemberExpression] {
  ModulePrefix MemberLeaf | JSXChildFieldAccess
}
JSXChildFieldAccess[@name=RecordFieldAccess] { jsxChildValue !member "." ModulePrefix? PropertyName }

JSXCallExpression[@name=CallExpression] {
  jsxAtomicValue !call "(" DotUncurried? commaSep<Argument> ")" |
  jsxAtomicValue !call UnitToken
}
JSXMemberExpression[@name=MemberExpression] {
  ModulePrefix MemberLeaf |
  JSXRecordFieldAccess |
  jsxAtomicValue !member IndexOpen expression ~annotation (IndexConstraint !parenConstraint)? "]"
}
JSXRecordFieldAccess[@name=RecordFieldAccess] { jsxAtomicValue !member "." ModulePrefix? PropertyName }

@external propSource rescriptHighlight from "./highlight"

@detectDelim
